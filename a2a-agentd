CONFIG_FILE = Path.home() / ".config/a2a-agents/agents.toml"
KEY_FILE = Path.home() / ".config/a2a-agents/api-key"
STATE_DIR = Path.home() / ".local/state/a2a-agents"
# Identifies, in the agent card, the one thing a generic A2A client has to
# know that the protocol does not say: the workdir a new context must pin.
WORKDIR_EXTENSION = "urn:x-a2a-mesh:workdir"


def log(msg: str) -> None:
    # Dated, every physical line: the log files are never rotated, so a
    # bare clock time stops meaning anything after the first midnight.
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print("\n".join(f"{stamp} {line}" for line in msg.splitlines()),
          flush=True)


class TurnFailed(RuntimeError):
    """A failure this file diagnosed itself — a refusal, a timeout, a CLI
    that exited non-zero. Its message is the whole story, so the log gets
    no traceback for it; any other exception is a bug and gets one."""


def load_or_create_key() -> str:
    """Create the key atomically (write-then-link), so neither concurrent
    first starts nor a crash mid-write can leave a readable empty key file
    — an empty key would turn compare_digest into an accept-all."""
    if not KEY_FILE.exists():
        KEY_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = KEY_FILE.with_name(f".api-key.{os.getpid()}.tmp")
        tmp.unlink(missing_ok=True)  # stale leftover after PID reuse
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secrets.token_hex(32) + "\n")
        try:
            os.link(tmp, KEY_FILE)  # atomic; loses gracefully to a racer
        except FileExistsError:
            pass
        finally:
            os.unlink(tmp)
    key = KEY_FILE.read_text().strip()
    if len(key) < 32:
        sys.exit(f"{KEY_FILE} is empty or too short — delete it and restart")
    return key


def resolve_pass_env(mapping: dict[str, str]) -> dict[str, str]:
    """Fetch secrets from pass(1). Needs gpg-agent to have the passphrase
    cached (run any `pass show` in your own shell to prime it)."""
    env = {}
    for var, entry in mapping.items():
        res = subprocess.run(["pass", "show", entry],
                             capture_output=True, text=True, timeout=30)
        if res.returncode != 0:
            raise TurnFailed(
                f"pass show {entry} failed: {res.stderr.strip() or 'no output'}")
        secret = res.stdout.splitlines()[0].strip() if res.stdout else ""
        if not secret:
            raise TurnFailed(f"pass entry {entry} is empty")
        env[var] = secret
    return env


def check_stanza(cfg: dict) -> None:
    """Refuse the type errors TOML makes easy — port = "8001", timeout =
    "30", extra_args = "--flag" — at startup, with the key named. Left
    alone, the first two surface as tracebacks deep in uvicorn or in
    every turn's wait_for, and the third splats one flag into its
    characters on the CLI's command line."""
    port = cfg["port"]
    if isinstance(port, bool) or not isinstance(port, int) or not 0 < port < 65536:
        raise ValueError(f"port must be an integer from 1 to 65535, not {port!r}")
    timeout = cfg.get("timeout", 1800)
    if (isinstance(timeout, bool) or not isinstance(timeout, int | float)
            or timeout <= 0):
        raise ValueError(
            f"timeout must be a positive number of seconds, not {timeout!r}")
    command = cfg.get("command", "")
    if not isinstance(command, str):
        raise ValueError(f"command must be a string, not {command!r}")
    for key in ("extra_args", "trusted_workdirs"):
        val = cfg.get(key, [])
        if not (isinstance(val, list) and all(isinstance(v, str) for v in val)):
            raise ValueError(f"{key} must be a list of strings, not {val!r}")
    for key, values in (("env", "values"), ("env_from_pass", "pass entries")):
        env = cfg.get(key, {})
        if not (isinstance(env, dict) and all(
                isinstance(k, str) and isinstance(v, str)
                for k, v in env.items())):
            raise ValueError(
                f"{key} must map variable names to {values}, not {env!r}")


class CliAdapter:
    """Build argv and parse output for one CLI flavour."""

    KINDS = ("claude", "gemini", "codex", "kimi")

    def __init__(self, kind: str, command: str, extra_args: list[str]):
        if kind not in self.KINDS:
            # Checked here, at startup, rather than on the first turn: a
            # daemon that starts cleanly and then fails every request is
            # the worse way to learn about a typo in agents.toml.
            raise ValueError(f"unknown adapter kind {kind!r} "
                             f"(one of: {', '.join(self.KINDS)})")
        self.kind = kind
        self.command = command
        self.extra = extra_args

    def chooses_own_id(self) -> bool:
        # claude and gemini accept a caller-chosen --session-id;
        # codex and kimi mint their own, discovered from output.
        return self.kind in ("codex", "kimi")

    def build(self, prompt: str, native_id: str | None, resume: bool,
              lastmsg: str, trusted: bool = False) -> tuple[list[str], str | None]:
        """Return (argv, stdin_text). The prompt travels via stdin where the
        CLI supports it, keeping it out of /proc/<pid>/cmdline."""
        c = self.command
        if self.kind == "claude":
            sel = ["--resume", native_id] if resume else ["--session-id", native_id]
            return [c, "-p", "--output-format", "json", *sel, *self.extra], prompt
        if self.kind == "gemini":
            sel = ["--resume", native_id] if resume else ["--session-id", native_id]
            # headless gemini refuses untrusted workspaces; bypass only when
            # the configuration vouches for the workdir. NB `-p ""` + stdin
            # is lightly documented but verified behaviour ("Appended to
            # input on stdin"): the prompt arrives wholly via stdin.
            trust = ["--skip-trust"] if trusted else []
            return [c, "-o", "json", *trust, *sel, *self.extra, "-p", ""], prompt
        if self.kind == "codex":
            # extra_args go before the subcommand: `codex exec resume` takes a
            # narrower flag set than `codex exec` (no --approve-for-me, -m, -s
            # …), so appending them makes every resumed turn exit 2. The
            # global position parses for both.
            common = ["--json", "--skip-git-repo-check",
                      "--output-last-message", lastmsg]
            if resume:
                return [c, *self.extra, "exec", "resume",
                        *common, native_id, "-"], prompt
            return [c, *self.extra, "exec", *common, "-"], prompt
        if self.kind == "kimi":
            # kimi's own session.resume_hint says `kimi -r <id>`; it has no
            # stdin prompt mode, so its prompt remains visible in argv
            sel = ["-r", native_id] if resume else []
            return [c, *sel, "--output-format", "stream-json", *self.extra,
                    "-p", prompt], None
        raise ValueError(f"unknown adapter kind: {self.kind}")

    def parse(self, stdout: str, lastmsg: str) -> tuple[str, str | None]:
        """Return (reply_text, native_session_id or None if unchanged)."""
        if self.kind == "claude":
            j = json.loads(stdout)
            return j.get("result", ""), j.get("session_id")
        if self.kind == "gemini":
            j = json.loads(stdout)
            text = j.get("response") or j.get("result") or ""
            sid = j.get("sessionId") or (j.get("stats") or {}).get("sessionId")
            return text, sid
        if self.kind == "codex":
            sid, texts = None, []
            for line in stdout.splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                sid = (sid or ev.get("thread_id") or ev.get("session_id")
                       or (ev.get("msg") or {}).get("session_id"))
                item = ev.get("item") or {}
                if item.get("type") == "agent_message":
                    texts.append(item.get("text", ""))
                if (ev.get("msg") or {}).get("type") == "agent_message":
                    texts.append(ev["msg"].get("message", ""))
            text = ""
            if lastmsg and os.path.exists(lastmsg):
                text = Path(lastmsg).read_text().strip()
            return text or "\n".join(texts), sid
        if self.kind == "kimi":
            # Events look like {"role":"assistant","content":"..."} and
            # {"role":"meta","type":"session.resume_hint","session_id":"..."}
            sid, texts = None, []
            for line in stdout.splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                sid = sid or ev.get("session_id")
                if ev.get("role") == "assistant" and isinstance(
                        ev.get("content"), str):
                    texts.append(ev["content"])
            return "\n".join(texts), sid
        raise ValueError(f"unknown adapter kind: {self.kind}")

    def error_hint(self, stdout: str, cli_only: bool = False) -> str:
        """The reason a CLI failed is not always on stderr. codex reports a
        usage limit as a JSON event on stdout and writes no stderr at all,
        which left the daemon reporting `exited 1 after 5s: \'\'`. Mine the
        structured output for the message before giving up on it.

        `cli_only` drops the one branch that can carry model-authored text —
        claude's is_error/result, where `result` is also the field the
        model's own reply arrives in. Callers that merely display the
        message want everything; callers that pattern-match it must not
        match on something the model wrote."""
        best = ""
        for line in stdout.splitlines():
            line = line.strip()
            if not (line.startswith("{") and line.endswith("}")):
                continue
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if not isinstance(ev, dict):
                continue
            msg = None
            if ev.get("type") == "error":
                msg = ev.get("message")
            elif isinstance(ev.get("error"), dict):
                msg = ev["error"].get("message")
            elif isinstance(ev.get("error"), str):
                msg = ev["error"]
            elif (not cli_only and ev.get("is_error")
                    and isinstance(ev.get("result"), str)):
                msg = ev["result"]
            if isinstance(msg, str) and msg.strip():
                best = msg.strip()  # keep the last: the most specific
        return best


class CliAgentExecutor(AgentExecutor):
    def __init__(self, name: str, cfg: dict):
        check_stanza(cfg)
        self.name = name
        self.cfg = cfg
        self.adapter = CliAdapter(cfg["kind"], cfg.get("command", name),
                                  cfg.get("extra_args", []))
        # gemini only: each entry trusts that directory and its whole subtree.
        # Resolved, because the subtree test below is lexical: an unresolved
        # entry would both admit paths outside the tree and miss legitimate
        # ones reached through a symlink.
        self.trusted_workdirs = [Path(p).expanduser().resolve()
                                 for p in cfg.get("trusted_workdirs", [])]
        if cfg.get("trust_workspace") is not None:
            # Installs never overwrite an existing config, so this key can
            # outlive the release that read it — say so rather than let
            # gemini quietly stop trusting a workspace that used to work.
            log(f"{name}: trust_workspace is obsolete and ignored; list the "
                f"directories to trust in trusted_workdirs instead")
        if cfg.get("workdir") is not None:
            # Same treatment: this key only fed the migration of state
            # entries that predate per-context workdirs, which is gone.
            log(f"{name}: workdir is obsolete and ignored; every context "
                f"pins its own on its first message")
        self.timeout = cfg.get("timeout", 1800)
        self.state_file = STATE_DIR / f"{name}.json"
        self.sessions: dict[str, dict] = {}
        if self.state_file.exists():
            try:
                loaded = json.loads(self.state_file.read_text())
                if not isinstance(loaded, dict):
                    # Valid JSON of the wrong shape used to get past here and
                    # kill the daemon on .items() below. That happens during
                    # startup, so systemd restarted it straight back into the
                    # same crash until the start limit gave up.
                    raise ValueError(
                        f"expected an object, got {type(loaded).__name__}")
                self.sessions = loaded
            except (ValueError, OSError) as err:
                # The mesh survives state loss by design (create-collision
                # retry); refusing to start on unreadable state would be
                # strictly worse than starting empty.
                bad = self.state_file.with_suffix(
                    f".corrupt-{int(time.time())}")
                try:
                    self.state_file.rename(bad)
                    log(f"state file was unusable ({err}); moved to {bad}, "
                        f"starting empty")
                except OSError as mv_err:
                    # Do not claim a rename that failed: the next save_state
                    # will overwrite the original, so this log line is the
                    # last trace the corrupt content ever existed.
                    log(f"state file was unusable ({err}) and could not be "
                        f"moved aside ({mv_err}); starting empty — the next "
                        f"save will overwrite it")
        dropped = {}
        for ctx, val in list(self.sessions.items()):
            if not (isinstance(val, dict) and "session" in val
                    and isinstance(val.get("session"), str | None)
                    and isinstance(val.get("workdir"), str | None)):
                # A wedge-shaped value — no dict (the bare-string schema
                # from before per-context workdirs lands here too), no
                # "session" key, or fields of the wrong type ({"session":
                # 42} would raise in _pin_workdir or exec argv on every
                # turn, for ever, and only hand-editing the file brings
                # the context back.
                dropped[ctx] = val
                del self.sessions[ctx]
        if dropped:
            # Set the values aside rather than deleting them: the flush
            # below makes the drop durable at once, and a typo'd key may
            # name a perfectly recoverable session. The unreadable-file
            # path above keeps its evidence; this path should too.
            aside = self.state_file.with_suffix(
                f".dropped-{int(time.time())}")
            fd = os.open(aside, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(json.dumps(dropped, indent=1, default=str))
                # Synced before save_state commits the drop below: the
                # evidence must not be the less durable half of the pair.
                f.flush()
                os.fsync(f.fileno())
            log(f"dropped {len(dropped)} malformed state "
                f"entr{'y' if len(dropped) == 1 else 'ies'} "
                f"({', '.join(map(repr, dropped))}); values kept in {aside}")
            # Flush eagerly so the file on disk never misrepresents the
            # state the daemon is actually running with.
            self.save_state()
        self.locks: dict[str, asyncio.Lock] = {}

    def save_state(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        tmp = self.state_file.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(self.sessions, indent=1))
            f.flush()
            os.fsync(f.fileno())
        tmp.rename(self.state_file)
        # Sync the rename as well: a context->session map that loses its
        # last entries to a power cut orphans those conversations.
        dfd = os.open(STATE_DIR, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)

    async def execute(self, context: RequestContext,
                      event_queue: EventQueue) -> None:
        prompt = context.get_user_input()
        ctx_id = context.context_id
        req_workdir = None
        if context.message and context.message.metadata:
            req_workdir = context.message.metadata.get("workdir")
        lock = self.locks.setdefault(ctx_id, asyncio.Lock())
        try:
            # Decide refusals before queueing behind a running turn. They
            # depend only on stored state, so waiting changes nothing except
            # who is left to hear the answer: a caller that queues for
            # minutes to be told its workdir was wrong has usually gone by
            # then — a2a-post exits after a few seconds — and the refusal
            # reaches nobody. run_turn checks again under the lock, which is
            # the authoritative one; this only moves the failure forward.
            self._pin_workdir(ctx_id, self.sessions.get(ctx_id), req_workdir)
            async with lock:
                reply, native = await self.run_turn(ctx_id, prompt,
                                                    req_workdir)
            meta = {"agent": self.name, "native_session_id": native}
        except Exception as err:
            # A parse failure counts as a bug here even though it arrives
            # wrapped: the traceback says where in parse() the CLI's output
            # stopped matching, which its message alone cannot.
            trace = ("" if isinstance(err, TurnFailed)
                     else "\n" + traceback.format_exc().rstrip())
            log(f"[{ctx_id!r}] FAILED: {err}{trace}")
            reply = f"ERROR from {self.name} worker: {err}"
            meta = {"agent": self.name, "error": True}
        msg = new_agent_text_message(reply, context_id=ctx_id,
                                     task_id=context.task_id)
        msg.metadata = meta
        await event_queue.enqueue_event(msg)

    def _pin_workdir(self, ctx_id: str, entry: dict | None,
                     requested) -> str:
        """A context pins its working directory on first use and keeps it
        for life — several CLIs scope their session stores to the directory
        they run in, so moving a conversation would orphan its session."""
        if requested is not None and not (isinstance(requested, str)
                                          and requested.strip()):
            raise TurnFailed("workdir metadata must be a non-empty string")
        # Resolved: the pin is compared lexically (here and against
        # trusted_workdirs), so ".." components, symlinks and relative paths
        # must be flattened before they mean anything. Resolving also makes
        # the pin stable — a relative "." would otherwise be stored verbatim
        # and re-interpreted against the daemon's cwd on every later turn.
        req = str(Path(requested).expanduser().resolve()) if requested else None
        pinned = entry.get("workdir") if entry else None
        if pinned:
            pinned = str(Path(pinned).expanduser().resolve())
            if req and req != pinned:
                raise TurnFailed(
                    f"context {ctx_id!r} is pinned to workdir {pinned}; for "
                    f"{req} use a new context name (a new conversation)")
            return pinned
        if not req:
            raise TurnFailed(
                f"context {ctx_id!r} has no pinned workdir; set one on its "
                'first message — metadata {"workdir": "/path"} via '
                "a2a-send --workdir (or --here), a2a-mcp send(..., workdir=...), or "
                "A2A Inspector's Message Metadata field")
        if not Path(req).is_dir():
            raise TurnFailed(f"workdir {req} is not an existing directory")
        return req

    async def run_turn(self, ctx_id: str, prompt: str,
                       req_workdir) -> tuple[str, str]:
        entry = self.sessions.get(ctx_id)
        workdir = self._pin_workdir(ctx_id, entry, req_workdir)
        wd = Path(workdir).resolve()
        trusted = any(wd.is_relative_to(t) for t in self.trusted_workdirs)
        native = entry["session"] if entry else None
        resume = native is not None
        if not resume and not self.adapter.chooses_own_id():
            # Deterministic native id: the same context maps to the same CLI
            # session while state is intact; after state loss the create
            # collides with the existing session and the retry below falls
            # back to resuming it.
            native = str(uuid.uuid5(uuid.NAMESPACE_URL,
                                    f"a2a://{self.name}/{ctx_id}"))
        if entry is None:
            # Record the pin before running the turn, not after it succeeds:
            # the CLI may create its session and then fail on output we
            # cannot parse, and a context left unpinned by that failure would
            # accept a different directory next time — pointing a native
            # session id at a directory whose store cannot see it.
            entry = {"session": native, "workdir": workdir}
            self.sessions[ctx_id] = entry
            self.save_state()

        env = os.environ.copy()
        # Let the CLI (and its subagents) know who and where it is, e.g. so
        # a2a-mcp `spool` can self-identify its sender.
        env["A2A_AGENT"] = self.name
        env["A2A_CONTEXT"] = ctx_id
        # Plain settings first, secrets last: a value from pass is never
        # shadowed by a plaintext one that names the same variable.
        env.update(self.cfg.get("env", {}))
        if self.cfg.get("env_from_pass"):
            env.update(await asyncio.to_thread(
                resolve_pass_env, self.cfg["env_from_pass"]))

        with tempfile.NamedTemporaryFile(mode="r", suffix=".txt") as lm:
            cmd, stdin_text = self.adapter.build(prompt, native, resume,
                                                 lm.name, trusted)
            log(f"[{ctx_id!r}] {'resume' if resume else 'new'} "
                f"native={native or '(cli-chosen)'} wd={workdir} "
                f"prompt={prompt[:60]!r}")
            t0 = time.monotonic()
            rc, stdout, stderr = await self._invoke(cmd, stdin_text, env,
                                                    self.timeout, workdir)
            # Two recoverable session mishaps, retried once in the opposite
            # mode: a create that collides with an existing session (state
            # was lost), and a resume of a session the CLI no longer has
            # (CLIs expire or directory-scope their stores). The matching is
            # anchored to session-lookup phrases on purpose: those fail at
            # startup before the agent does any work, so the retry cannot
            # repeat side effects of a partially-run turn.
            retry: bool | None = None
            # cli_only: this text decides whether to abandon a session, so
            # it must come from the CLI's own error fields. Model output is
            # not evidence about the session — a turn that merely quotes
            # "no conversation found" would otherwise orphan a healthy one.
            hint = (self.adapter.error_hint(stdout, cli_only=True)
                    if rc != 0 else "")
            low = f"{stderr} {hint}".lower()
            if (rc != 0 and not resume and not self.adapter.chooses_own_id()
                    and "already" in low and "session" in low):
                retry = True
                log(f"[{ctx_id!r}] create collided with existing session, "
                    f"retrying as resume")
            elif rc != 0 and resume and (
                    "invalid session" in low          # gemini
                    or "no conversation found" in low  # claude
                    or "session not found" in low
                    or "different directory" in low):  # kimi
                # NB deliberately narrow: a bare "not found" in stderr must
                # not repoint the context and orphan a healthy session
                retry = False
                log(f"[{ctx_id!r}] resume failed ({stderr.strip()[:120]!r}), "
                    f"starting a fresh native session")
            if retry is not None:
                resume = retry
                if not resume:
                    # Recovery path: nothing needs the deterministic id any
                    # more, and reusing it can wedge on a CLI that refuses an
                    # id existing elsewhere — take a genuinely fresh one.
                    native = (None if self.adapter.chooses_own_id()
                              else str(uuid.uuid4()))
                cmd, stdin_text = self.adapter.build(prompt, native, resume,
                                                     lm.name, trusted)
                # The retry inherits the remaining budget, so the two
                # attempts together stay within the client's expectations.
                left = max(60.0, self.timeout - (time.monotonic() - t0))
                rc, stdout, stderr = await self._invoke(cmd, stdin_text, env,
                                                        left, workdir)
            dt = time.monotonic() - t0
            if rc != 0:
                detail = stderr.strip()
                hint = self.adapter.error_hint(stdout)
                if hint and hint not in detail:
                    detail = f"{detail} {hint}".strip()
                if not detail:
                    # Neither stream said anything usable; the tail of stdout
                    # beats reporting an empty string.
                    detail = stdout.strip()[-300:] or "no output on either stream"
                raise TurnFailed(
                    f"{cmd[0]} exited {rc} after {dt:.0f}s: {detail[:500]!r}")
            try:
                text, parsed_id = self.adapter.parse(stdout, lm.name)
            except Exception as err:
                raise RuntimeError(
                    f"cannot parse {cmd[0]} output ({err}); "
                    f"stdout tail: {stdout[-300:]!r}") from err
        native = parsed_id or native
        if not native:
            raise TurnFailed("could not determine native session id from output")
        if (entry is None or entry.get("session") != native
                or entry.get("workdir") != workdir):
            self.sessions[ctx_id] = {"session": native, "workdir": workdir}
            self.save_state()
        log(f"[{ctx_id!r}] done in {dt:.0f}s native={native} reply={len(text)}ch")
        return text, native

    async def _invoke(self, cmd: list[str], stdin_text: str | None,
                      env: dict, timeout: float,
                      cwd: str) -> tuple[int, str, str]:
        proc = await asyncio.create_subprocess_exec(
            *cmd, cwd=cwd, env=env, start_new_session=True,
            stdin=asyncio.subprocess.PIPE,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
        try:
            stdout, stderr = await asyncio.wait_for(
                proc.communicate(stdin_text.encode() if stdin_text else None),
                timeout=timeout)
        except TimeoutError:
            # SIGKILL the whole process group, not just the CLI wrapper, so
            # tools the agent spawned do not outlive the failed turn. The
            # saved pid IS the pgid (start_new_session), and stays valid as
            # a group id even after the leader itself has exited.
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                proc.kill()
            await proc.wait()
            raise TurnFailed(f"timed out after {timeout:g}s") from None
        return (proc.returncode, stdout.decode(errors="replace"),
                stderr.decode(errors="replace"))

    async def cancel(self, context: RequestContext,
                     event_queue: EventQueue) -> None:
        raise RuntimeError("cancel is not supported")


class KeyAuth:
    """Minimal ASGI middleware: require X-API-Key on every HTTP request,
    except agent-card discovery — A2A expects the card to be anonymously
    fetchable, with the required scheme declared inside the card."""

    OPEN_PATHS = ("/.well-known/agent-card.json", "/.well-known/agent.json")

    def __init__(self, app, key: str):
        self.app = app
        self.key = key.encode()

    async def __call__(self, scope, receive, send):
        if scope["type"] == "lifespan":
            await self.app(scope, receive, send)
            return
        if scope["type"] != "http":
            # Default-deny anything else (e.g. websocket): nothing serves it
            # today, and it must not arrive unauthenticated if it ever does.
            if scope["type"] == "websocket":
                await send({"type": "websocket.close", "code": 1008})
            return
        if not (scope.get("method") == "GET"
                and scope.get("path") in self.OPEN_PATHS):
            headers = {k.lower(): v for k, v in scope.get("headers", [])}
            if not secrets.compare_digest(headers.get(b"x-api-key", b""),
                                          self.key):
                await send({"type": "http.response.start", "status": 401,
                            "headers": [(b"content-type", b"text/plain")]})
                await send({"type": "http.response.body",
                            "body": b"missing or bad X-API-Key\n"})
                return
        await self.app(scope, receive, send)


def load_config() -> dict[str, dict]:
    """The agent stanzas of agents.toml. A missing or unparsable file is
    refused with a message rather than a traceback: the reason for a
    daemon that will not start should be the last line of its log, not
    buried in a stack trace that systemd retries five times."""
    try:
        conf = tomllib.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        sys.exit(f"{CONFIG_FILE} not found — `make install` creates it")
    except tomllib.TOMLDecodeError as err:
        sys.exit(f"{CONFIG_FILE}: {err}")
    return {n: c for n, c in conf.items() if isinstance(c, dict)}


def agent_card(name: str, cfg: dict) -> AgentCard:
    """What anonymous discovery serves: the endpoint, the key scheme it
    demands, and the one skill with its workdir contract."""
    return AgentCard(
        name=f"{name}-worker",
        description=f"Local A2A wrapper around the `{cfg.get('command', name)}` "
                    f"CLI (adapter: {cfg['kind']})",
        url=f"http://127.0.0.1:{cfg['port']}",
        version="1.0.0",
        capabilities=AgentCapabilities(streaming=False, extensions=[
            # The spec's mechanism for a requirement a client must honour;
            # the skill description repeats it in prose for the humans.
            AgentExtension(
                uri=WORKDIR_EXTENSION, required=True,
                description="A new contextId must carry message metadata "
                            '{"workdir": "/absolute/path"}: the directory '
                            "the agent runs in, pinned for the life of the "
                            "context; a different directory needs a new "
                            "contextId.")]),
        default_input_modes=["text/plain"],
        default_output_modes=["text/plain"],
        security_schemes={"apiKey": SecurityScheme.model_validate(
            {"type": "apiKey", "name": "X-API-Key", "in": "header"})},
        security=[{"apiKey": []}],
        skills=[AgentSkill(
            id="chat", name="chat", tags=["cli", cfg["kind"]],
            # The card is the one place a generic client learns the
            # contract before its first message is refused.
            description="Send a prompt; the wrapped CLI agent replies. "
                        "Reuse contextId to continue a conversation. A new "
                        "contextId must carry message metadata "
                        '{"workdir": "/absolute/path"}: the directory the '
                        "agent runs in, pinned for the life of the context.")],
    )


def main() -> None:
    conf = load_config()
    if len(sys.argv) != 2 or sys.argv[1] not in conf:
        sys.exit(f"usage: a2a-agentd <agent>   (one of: {', '.join(conf)})")
    name = sys.argv[1]
    cfg = conf[name]
    # Only this daemon's own stanza has to be sound; a broken neighbour is
    # that neighbour's problem.
    for key in ("kind", "port"):
        if key not in cfg:
            sys.exit(f"{CONFIG_FILE}: [{name}] has no {key}")
    port = cfg["port"]
    try:
        executor = CliAgentExecutor(name, cfg)
    except ValueError as err:
        sys.exit(f"{CONFIG_FILE}: [{name}] {err}")
    handler = DefaultRequestHandler(
        agent_executor=executor, task_store=InMemoryTaskStore())
    app = A2AStarletteApplication(agent_card=agent_card(name, cfg),
                                  http_handler=handler).build()
    log(f"{name}-worker listening on 127.0.0.1:{port}")
    uvicorn.run(KeyAuth(app, load_or_create_key()),
                host="127.0.0.1", port=port, log_level="warning")


if __name__ == "__main__":
    main()
