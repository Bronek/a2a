# Agent definitions for a2a-agentd / a2a-mcp.
# Copied to ~/.config/a2a-agents/agents.toml by `make install` when that file
# does not exist yet; edit the copy, not this example.
#
# Per-agent keys:
#   kind          adapter: "claude" | "gemini" | "codex" | "kimi" | "cline"
#   command       CLI binary to run
#   port          loopback port for the A2A daemon
#   trusted_workdirs  gemini only: directories (each trusting its whole
#                 subtree) whose pinned contexts get --skip-trust
#   timeout       seconds before a task is killed (default 1800)
#   extra_args    appended to every invocation, e.g. permission/approval modes
#   env           VAR = "value" — plain environment for this agent's
#                 subprocess, for settings a CLI takes from its environment
#                 rather than its flags; never a secret, this file is readable
#   env_from_pass VAR = "pass entry" — resolved with pass(1) per task, only for
#                 this agent's subprocess, never stored or logged

[claude]
kind = "claude"
command = "claude"
port = 8002
# env_from_pass = { GH_TOKEN = "path/to/entry/in/pass" }
# Headless claude -p silently denies unapproved tools; this allowlists
# exactly the mesh server's tools (the narrowest grant of the four CLIs —
# no sandbox change, nothing else gains anything).
extra_args = ["--allowedTools", "mcp__a2a"]
# e.g. add: "--permission-mode", "acceptEdits"

[gemini]
kind = "gemini"
command = "gemini"
port = 8003
# Headless gemini refuses untrusted workspaces. A context pinned inside one
# of these directories gets --skip-trust, which lets that checkout's own
# .gemini/ config run as you — list only trees whose content you trust.
# trusted_workdirs = ["~/gits"]
# extra_args = ["--approval-mode", "auto_edit"]
extra_args = ["--allowed-mcp-server-names", "a2a"]

[codex]
kind = "codex"
command = "codex"
port = 8001
# Headless codex pins approval_policy to "never", which REFUSES anything
# needing approval (MCP tool calls included). --approve-for-me routes
# approvals through codex's automatic reviewer instead — a machine gate per
# action — at the price of widening the sandbox to workspace-write.
# --disable apps removes the built-in ChatGPT-apps tool suite, which has no
# business in a headless worker.
extra_args = ["-c", "model_reasoning_effort=high",
              "--approve-for-me", "--disable", "apps"]

[kimi]
kind = "kimi"
command = "kimi"
port = 8004
extra_args = []

[glm]
kind = "cline"
command = "cline"
port = 8005
# Driven over cline's Agent Client Protocol (--acp), which ignores the
# CLI's provider and model flags: the model is chosen here, and the
# provider's key comes from pass. Another model is another stanza.
env = { CLINE_PROVIDER = "zai-coding-plan", CLINE_MODEL = "glm-5.3" }
env_from_pass = { CLINE_API_KEY = "zai/api-key" }
# Without auto-approval the daemon refuses every permission request a tool
# call raises, which leaves a worker that can only talk.
extra_args = ["--auto-approve", "true"]
