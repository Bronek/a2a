[Unit]
Description=A2A agent daemon (%i)
# Host-agnostic on purpose. A home directory shared between hosts keeps the
# mesh to one of them with a drop-in (systemctl --user edit), not here:
#   [Unit]
#   ConditionHost=<host>*
# RestartSec=3 alone never trips the default 5-per-10s start limit, so a
# permanent failure (bad config, occupied port) would crash-loop forever;
# widen the window so systemd gives up after five failures in a minute.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# exec, not the default simple: a start whose execve fails (the script
# missing after a botched install) is then reported as a failed start
# rather than a success followed by a crash.
Type=exec
# Self-applying privacy migration: UMask only protects newly created files,
# pre-hardening state/logs would otherwise stay world-readable.
ExecStartPre=/usr/bin/chmod -R go-rwx %h/.local/state/a2a-agents
ExecStart=%h/.local/bin/a2a-agentd %i
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Logs and state may reference private conversations: no group/other access.
UMask=0077
# Files rather than the journal: not every host lets this user read
# journalctl, and a plain file can be tailed anywhere:
#   tail -f ~/.local/state/a2a-agents/<agent>.log
# The directory is created by `make install`; it must exist before the
# unit starts, because systemd opens append: targets before any
# ExecStartPre runs (a missing parent fails the start with 209/STDOUT).
StandardOutput=append:%h/.local/state/a2a-agents/%i.log
StandardError=append:%h/.local/state/a2a-agents/%i.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
