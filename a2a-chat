#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["httpx>=0.27"]
# ///
"""REPL / one-shot client for the local A2A agent daemons.

Usage:
  a2a-chat <agent>                  interactive REPL
  a2a-chat <agent>/<ctx> "msg"      one-shot, prints the reply and exits
                                    (exit 2 if the worker reported an error)
  a2a-post <agent>/<ctx> "msg"      fire and forget: the worker runs the turn
  a2a-chat <agent> --post "msg"     but the reply is not waited for

An address is the pair <agent>/<context>; write it as one token so it can be
copied around without the agent falling off. --context takes either half.
  a2a-chat --status                 show which daemons are up (needs no key)
  a2a-chat <agent> --context ID     use a chosen A2A context id (any string);
                                    the daemon maps it to a native CLI session
  a2a-chat <agent> --workdir DIR    pin a NEW context's working directory
                                    (required on a context's first message)

REPL commands: /context [id]  show or switch context
               /workdir [dir] show or set the workdir a NEW context pins
               /new           start a fresh context
               /exit
"""
import argparse
import json
import sys
import tomllib
import uuid
from pathlib import Path

import httpx

CONFIG_FILE = Path.home() / ".config/a2a-agents/agents.toml"
KEY_FILE = Path.home() / ".config/a2a-agents/api-key"


def die(msg: str) -> None:
    sys.exit(f"a2a-chat: {msg}")


def load_conf() -> dict:
    conf = tomllib.loads(CONFIG_FILE.read_text())
    return {n: c for n, c in conf.items()
            if isinstance(c, dict) and "port" in c}


def client_for(cfg: dict) -> httpx.Client:
    try:
        key = KEY_FILE.read_text().strip()
    except FileNotFoundError:
        key = ""
    if not key:
        die(f"{KEY_FILE} not found or empty — start a daemon once to create it")
    # Read timeout tracks the daemon's own per-agent task timeout.
    read = cfg.get("timeout", 1800) + 120
    return httpx.Client(base_url=f"http://127.0.0.1:{cfg['port']}",
                        headers={"X-API-Key": key},
                        timeout=httpx.Timeout(10, read=read))


def show_status(conf: dict) -> None:
    # Card endpoints are anonymous: no key is read and, deliberately, none is
    # sent — a squatter on a down daemon's port must not receive the key.
    for name, cfg in conf.items():
        state = "DOWN"
        for path in ("/.well-known/agent-card.json", "/.well-known/agent.json"):
            try:
                r = httpx.get(f"http://127.0.0.1:{cfg['port']}{path}",
                              timeout=3)
            except httpx.TransportError:
                continue
            if r.status_code == 200:
                try:
                    state = f"up ({r.json().get('name')})"
                except (ValueError, AttributeError):
                    state = "answers, but not with an agent card"
                break
            state = f"HTTP {r.status_code}"
        print(f"{name:>8}  port {cfg['port']}  {state}")


def extract_text(result: dict) -> tuple[str, dict]:
    """Pull reply text + metadata out of an A2A Message or Task result."""
    if result.get("kind") == "message":
        parts = result.get("parts", [])
        text = "\n".join(p.get("text", "") for p in parts
                         if p.get("kind") == "text")
        return text, result.get("metadata") or {}
    if result.get("kind") == "task":
        chunks, meta = [], {}
        for art in result.get("artifacts") or []:
            for p in art.get("parts", []):
                if p.get("kind") == "text":
                    chunks.append(p.get("text", ""))
        for m in reversed(result.get("history") or []):
            if m.get("role") == "agent":
                meta = m.get("metadata") or {}
                if not chunks:
                    chunks = [p.get("text", "") for p in m.get("parts", [])
                              if p.get("kind") == "text"]
                break
        return "\n".join(chunks), meta
    return json.dumps(result, indent=2), {}


def send(client: httpx.Client, context_id: str, text: str,
         workdir: str | None = None,
         read_timeout: float | None = None) -> tuple[str, dict]:
    message = {
        "kind": "message",
        "role": "user",
        "messageId": str(uuid.uuid4()),
        "contextId": context_id,
        "parts": [{"kind": "text", "text": text}],
    }
    if workdir:
        # A new context pins its working directory from this metadata.
        message["metadata"] = {"workdir": workdir}
    payload = {
        "jsonrpc": "2.0",
        "id": str(uuid.uuid4()),
        "method": "message/send",
        "params": {"message": message},
    }
    kw = {} if read_timeout is None else {
        "timeout": httpx.Timeout(10, read=read_timeout)}
    r = client.post("/", json=payload, **kw)
    r.raise_for_status()
    try:
        data = r.json()
    except ValueError:
        raise RuntimeError("daemon answered HTTP 200 with a non-JSON body")
    if "error" in data:
        raise RuntimeError(f"A2A error {data['error'].get('code')}: "
                           f"{data['error'].get('message')}")
    if "result" not in data:
        raise RuntimeError("malformed JSON-RPC response: no result")
    return extract_text(data["result"])


# Long enough for a refusal the daemon makes before starting the CLI —
# an unpinned workdir, a pin mismatch — to come back and be reported.
# A real turn takes minutes and will not answer inside it.
POST_GRACE_SECONDS = 6


def post(client: httpx.Client, agent: str, context_id: str, text: str,
         workdir: str | None = None) -> None:
    """Send without waiting for the turn. The worker still runs it to
    completion and its session advances; only the reply is discarded."""
    try:
        reply, meta = send(client, context_id, text, workdir,
                           read_timeout=POST_GRACE_SECONDS)
    except httpx.ReadTimeout:
        # The expected path: the worker is busy doing the work.
        print(f"queued to {agent} (context {context_id})", file=sys.stderr)
        return
    except (httpx.HTTPError, RuntimeError) as err:
        die(f"{agent} daemon unreachable or failed: {err}")
    # It answered inside the grace period: either a refusal, or a turn so
    # short it finished already. Either way the caller should see it.
    if meta.get("error"):
        print(reply, file=sys.stderr)
        sys.exit(2)
    print(reply)


def repl(client: httpx.Client, agent: str, context_id: str,
         workdir: str | None) -> None:
    try:
        import readline  # noqa: F401  (line editing / history)
    except ImportError:
        pass
    print(f"--- {agent} | context {context_id} | /exit to quit ---")
    print(f"    workdir {workdir}" if workdir else
          "    no workdir — a new context needs one: /workdir <dir>")
    last_native = None
    while True:
        try:
            line = input(f"[{agent}] > ").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return
        if not line:
            continue
        if line in ("/exit", "/quit", "exit", "quit"):
            return
        if line.startswith("/workdir"):
            arg = line.removeprefix("/workdir").strip()
            if arg:
                workdir = str(Path(arg).expanduser())
            print(f"workdir: {workdir or '(unset)'}")
            continue
        if line.startswith("/context"):
            arg = line.removeprefix("/context").strip()
            if arg:
                # An existing conversation already carries its own pin, and
                # offering ours could only trip the mismatch refusal. Use
                # /workdir afterwards if this name is in fact a new context.
                context_id, last_native, workdir = arg, None, None
            print(f"context: {context_id} | workdir: {workdir or '(pinned)'}")
            continue
        if line == "/new":
            # A fresh context in the same directory is the common case, so
            # the workdir carries over.
            context_id, last_native = str(uuid.uuid4()), None
            print(f"context: {context_id} | "
                  f"workdir: {workdir or '(unset — /workdir <dir>)'}")
            continue
        try:
            text, meta = send(client, context_id, line, workdir)
        except KeyboardInterrupt:
            print("\n[interrupted locally — the worker still finishes this "
                  "turn server-side; its reply is lost but the session "
                  "advances]\n")
            continue
        except Exception as err:
            print(f"\n[error] {err}\n")
            continue
        native = meta.get("native_session_id")
        if native and native != last_native:
            print(f"(native {agent} session: {native})")
            last_native = native
        if meta.get("error"):
            print(f"\n[worker error] {text}\n")
            continue
        print(f"\n{text}\n")


def split_address(text: str, conf: dict, bare_is_agent: bool) -> tuple:
    """Split an <agent>/<context> address into its two halves.

    A slash always separates the pair and the part before it must name a
    configured agent, so the form can never quietly mean something else.
    Writing the address as one token is the point: it can be copied out of
    a log or a note without the agent falling off on the way."""
    head, sep, tail = text.partition("/")
    if not sep:
        return (text, None) if bare_is_agent else (None, text)
    if head not in conf:
        die(f"{head!r} is not an agent (one of: {', '.join(conf)}); "
            f"an address is <agent>/<context>")
    if not tail:
        die(f"nothing after {head!r}/ — an address is <agent>/<context>")
    return head, tail


def main() -> None:
    ap = argparse.ArgumentParser(add_help=True)
    # No default: the agents are peers, and every context name is valid on
    # every one of them, so a defaulted agent cannot fail — it silently
    # opens a new conversation on the wrong worker.
    ap.add_argument("agent", nargs="?")
    ap.add_argument("message", nargs="?",
                    help="one-shot message; without one, a2a-chat opens a REPL")
    ap.add_argument("--context",
                    help="context to use / resume, as <name> or "
                         "<agent>/<name>")
    ap.add_argument("--workdir", help="working directory to pin a NEW "
                    "context to (required on a context's first message)")
    ap.add_argument("--send", metavar="MSG", help="one-shot message, then exit")
    ap.add_argument("--status", action="store_true",
                    help="show daemon status for all configured agents")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--post", action="store_true",
                      help="do not wait for the reply; the worker still runs "
                           "the turn (the default when invoked as a2a-post)")
    mode.add_argument("--chat", action="store_true",
                      help="wait for the reply (overrides an a2a-post name)")
    args = ap.parse_args()

    # Invocation name selects the mode, so a2a-post is a symlink to this
    # script rather than a second copy of it; --post/--chat override it.
    posting = args.post or ("post" in Path(sys.argv[0]).name
                            and not args.chat)

    conf = load_conf()
    if args.status:
        show_status(conf)
        return
    # When --context carries the address, a lone positional is the message:
    # argparse fills positionals in order, so it would otherwise land in the
    # agent slot. Left alone if it names an agent, because then the two
    # spellings genuinely disagree and should say so.
    if (args.context and "/" in args.context and args.agent
            and args.message is None and "/" not in args.agent
            and args.agent not in conf):
        args.agent, args.message = None, args.agent

    # The mesh address is the pair (agent, context) — the daemon keys on
    # both — so it can be written as one token, in either position.
    agent = ctx = None
    if args.agent:
        agent, ctx = split_address(args.agent, conf, True)
    if args.context:
        c_agent, c_ctx = split_address(args.context, conf, False)
        if c_agent and agent and c_agent != agent:
            die(f"two different agents in one address, {agent!r} and "
                f"{c_agent!r} — name it once")
        if ctx and c_ctx and ctx != c_ctx:
            die(f"two different contexts, {ctx!r} and {c_ctx!r} — "
                f"name it once")
        agent, ctx = agent or c_agent, c_ctx or ctx
    if not agent:
        die(f"name an agent: one of {', '.join(conf)} "
            f"(only --status works without one)")
    if agent not in conf:
        die(f"unknown agent {agent!r} (one of: {', '.join(conf)})")
    args.agent = agent

    text_in = args.message or args.send
    if posting and not text_in:
        die("posting needs a message: a2a-post <agent>/<context> \"msg\"")

    context_id = ctx or str(uuid.uuid4())
    with client_for(conf[args.agent]) as client:
        if posting:
            post(client, args.agent, context_id, text_in, args.workdir)
        elif text_in:
            try:
                text, meta = send(client, context_id, text_in, args.workdir)
            except (httpx.HTTPError, RuntimeError) as err:
                die(f"{args.agent} daemon unreachable or failed: {err}")
            native = meta.get("native_session_id")
            if native:
                print(f"(context {context_id} -> native session {native})",
                      file=sys.stderr)
            if meta.get("error"):
                print(text, file=sys.stderr)
                sys.exit(2)
            print(text)
        else:
            repl(client, args.agent, context_id, args.workdir)


if __name__ == "__main__":
    main()
